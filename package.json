{
  "name": "@wildcatfi/wildcat-subgraph",
  "version": "2.0.28",
  "license": "UNLICENSED",
  "main": "index.js",
  "repository": "git@github.com:wildcat-finance/subgraph",
  "author": "d1ll0n <dillon@wildcat.finance>",
  "scripts": {
    "auth": "graph auth --studio",
    "codegen": "graph codegen -u",
    "build": "graph build",
    "deploy": "node scripts/deploy.js",
    "create-local": "graph create --node $NODE_HOST:$NODE_PORT/ wildcat-test-deployment",
    "remove-local": "graph remove --node $NODE_HOST:$NODE_PORT/ wildcat-test-deployment",
    "local:sepolia": "graph deploy --node $NODE_HOST:$NODE_PORT --ipfs $NODE_HOST:$IPFS_PORT wildcat-test-deployment --version-label v2.0.16",
    "local:mainnet": "graph deploy --node $NODE_HOST:$NODE_PORT --ipfs $NODE_HOST:$IPFS_PORT wildcat-test-mainnet --version-label v2.0.15",
    "test": "graph test",
    "netconfig": "node ./scripts/set-addresses",
    "postnetconfig": "yarn codegen",
    "deploy:sepolia": "yarn deploy goldsky sepolia",
    "deploy:mainnet": "yarn deploy goldsky mainnet",
    "deploy:plasma-testnet": "yarn deploy goldsky plasma-testnet",
    "deploy:plasma-mainnet": "yarn deploy goldsky plasma-mainnet",
    "deploy:mainnet-analytics": "yarn deploy dev mainnet wildcat_ethereum_mainnet_analytics",
    "deploy:sepolia-analytics": "yarn deploy dev sepolia wildcat_ethereum_sepolia_analytics"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.60.0",
    "@graphprotocol/graph-ts": "0.30.0",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@ethersproject/abi": "5.7.0",
    "matchstick-as": "0.5.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
